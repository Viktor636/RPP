POSTGRES_DB=flights_db
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql+psycopg://app:app@db:5432/flights_db

# Фиксированное начало расписания обеспечивает повторяемую генерацию.
SCHEDULE_START_DATE=2026-10-26
SCHEDULE_DAYS=120
OWN_FLIGHTS_PER_DAY=1500
PROVIDER_FLIGHTS_PER_DAY=500

PROVIDER1_URL=http://provider1:8000
PROVIDER2_URL=http://provider2:8000
PROVIDER3_URL=http://provider3:8000
PROVIDER_TIMEOUT_SECONDS=2.0
PROVIDER_RETRY_DELAY_SECONDS=0.2
